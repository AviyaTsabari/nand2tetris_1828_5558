class Catcher {
    field int x, y;
    field int width, height;

    constructor Catcher new() {
        let x = 220;
        let y = 230;
        let width = 70;
        let height = 10;

        do draw();
        return this;
    }

    method void draw() {
        do Screen.setColor(true);
        do Screen.drawRectangle(x, y, x + width, y + height);
        return;
    }

    method void erase() {
        do Screen.setColor(false);
        do Screen.drawRectangle(x, y, x + width, y + height);
        return;
    }

    method void moveLeft() {
        if (x > 5) {
            do erase();
            let x = x - 10;
            do draw();
        }
        return;
    }

    method void moveRight() {
        if (x < 435) {
            do erase();
            let x = x + 10;
            do draw();
        }
        return;
    }

    method int getX() {
        return x;
    }

    method int getY() {
        return y;
    }

    method int getWidth() {
        return width;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}