VMtranslate
librec_info: #(path: #(), lib_committed: "")
class
	{
	Main(dir)
		{
		outFile = dir $ "/Tar0.asm"

		.totalBuy = 0
		.totalCell = 0

		File(outFile, 'w')
			{ |out|

			for file in Dir(dir $ "/*.vm")
				{
				fileName = file.BeforeLast(".")
				out.Writeline(fileName)

				File(dir $ "/" $ file, 'r')
					{ |inp|

					while ((line = inp.Readline()) isnt false)
						{
						if line is ""
							continue

						first = line.BeforeFirst(" ")
						rest = line.AfterFirst(" ")

						arg1 = rest.BeforeFirst(" ")
						rest = rest.AfterFirst(" ")

						arg2 = rest.BeforeFirst(" ")
						arg3 = rest.AfterFirst(" ")

						if first is "buy"
							.handleBuy(arg1, arg2, arg3, out)
						else if first is "cell"
							.handleCell(arg1, arg2, arg3, out)
						}
					}
				}

			out.Writeline("TOTAL BUY: " $ .totalBuy)
			out.Writeline("TOTAL CELL: " $ .totalCell)

			Print("TOTAL BUY: " $ .totalBuy)
			Print("TOTAL CELL: " $ .totalCell)
			}
		}

	handleBuy(productName, amount, price, out)
		{
		sum = Number(amount) * Number(price)
		.totalBuy += sum

		out.Writeline("### BUY " $ productName $ " ###")
		out.Writeline(sum)
		}

	handleCell(productName, amount, price, out)
		{
		sum = Number(amount) * Number(price)
		.totalCell += sum

		out.Writeline("$$$ CELL " $ productName $ " $$$")
		out.Writeline(sum)
		}
	}
